# Пример настроек router-1c-mcp 0.8.0.
# Скопировать в .env рядом с docker-compose.yml и подставить свои значения.
#
# Значения читаются только из переменных окружения (rust/src/config.rs),
# файла конфигурации у роутера нет.

# --- Сеть -------------------------------------------------------------------
# Адрес и порт, которые слушает роутер. В контейнере слушать надо 0.0.0.0,
# иначе снаружи не достучаться.
MCP_HOST=0.0.0.0
MCP_PORT=8010

# trace | debug | info | warn | error
MCP_LOG_LEVEL=info

# --- Доступ к базам 1С -------------------------------------------------------
# Список баз — JSON-массив. Либо путь к файлу (приоритетнее):
MCP_ONEC_BASES_FILE=/app/bases.json
# либо тот же JSON строкой:
# MCP_ONEC_BASES=[{"name":"base-a","url":"http://server/ut","username":"<логин>","password":"***","service_root":"mcp","max_concurrent":4}]
#
# Поля базы: name (значение параметра base в вызове инструмента), url,
# username, password, service_root (по умолчанию "mcp" -> /hs/mcp/...),
# max_concurrent (потолок одновременных запросов к этой базе; без него — без лимита).
# Имена баз должны быть уникальны, иначе роутер не стартует.

# --- Белый список инструментов ----------------------------------------------
# Задаётся двумя способами:
#   1) этой переменной — имена через запятую;
#   2) секцией "tools_enabled" в файле состава (MCP_TOOLS_FILE, по умолчанию
#      tools.json рядом с файлом баз). Секция только читается и сохраняется
#      при каждой перезаписи файла:
#
#        {
#          "_generated": "2026-10-28T07:06:53Z",
#          "tools_enabled": ["execute_query", "db_tables", "list_artifacts"],
#          "common": [],
#          "separate": {}
#        }
#
#      В файле баз поле tools_enabled больше не читается: файл баз — только
#      подключения (0.8.0).
#
# Непустая переменная ПЕРЕКРЫВАЕТ файл состава. Пустая (или незаданная) —
# список берётся из файла состава. Нет ни там, ни там — фильтр ВЫКЛЮЧЕН,
# доступны все инструменты, которые отдали базы.
#
# В tools/list клиенту отдаются только разрешённые имена; вызов имени вне
# списка отбивается в роутере, до обращения к базе. Пробелы вокруг имён
# обрезаются, пустые элементы пропускаются.
#
# Состав инструментов собирается при старте со всех баз; не ответившие
# опрашиваются повторно раз в две минуты. Сам белый список читается только
# при старте, поэтому его смена требует перезапуска процесса (контейнера или
# службы).

# Вариант 1 — только чтение данных и метаданных (безопасный минимум):
# MCP_TOOLS_ENABLED=validate_query,execute_query,list_metadata_objects,get_metadata_structure,db_tables,db_table_fields

# Вариант 2 — чтение плюс журнал регистрации и артефакты (обработки, расширения):
MCP_TOOLS_ENABLED=validate_query,execute_query,list_metadata_objects,get_metadata_structure,eventlog_query,eventlog_filter_values,db_tables,db_table_fields,list_artifacts,export_artifact,import_artifact

# Вариант 3 — то же плюс чтение и запись полей ХранилищеЗначения:
# MCP_TOOLS_ENABLED=validate_query,execute_query,list_metadata_objects,get_metadata_structure,eventlog_query,eventlog_filter_values,db_tables,db_table_fields,list_artifacts,export_artifact,import_artifact,storage_reader,set_storage_value

# Вариант 4 — плюс изменение данных кодом. Работает только с полной версией
# расширения; сам инструмент внутри защищён режимами
# посчитать -> примерить -> применить, менять данные без пакета изменений он не умеет:
# MCP_TOOLS_ENABLED=validate_query,execute_query,list_metadata_objects,get_metadata_structure,eventlog_query,eventlog_filter_values,db_tables,db_table_fields,list_artifacts,export_artifact,import_artifact,storage_reader,set_storage_value,execute_code

# Имя, которого нет в снимке базы, роутер при старте пишет в журнал
# предупреждением — так видно, что расширение на базе старее списка.
# Отдельно: get_database_storage_structure в расширениях с 1.6.1 больше нет,
# его заменили db_tables + db_table_fields. Если он остался в списке — убрать.

# --- Повтор опроса недоступных баз -------------------------------------------
# Сколько раз повторять опрос баз без успешного снимка (интервал — две минуты).
# 0 — не повторять совсем. Не задано — берётся retry_attempts из файла баз,
# иначе пять попыток.
# MCP_RETRY_ATTEMPTS=5
